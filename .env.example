# Real turn-by-turn directions (src/lib/routing.ts, used by Navigate.tsx).
# Free key, no credit card: sign up at https://openrouteservice.org/dev/#/signup
# then grab it from your dashboard. Without this set, Navigate.tsx falls back
# to the scripted demo route instead of erroring.
VITE_ORS_API_KEY=<your openrouteservice.org api key>

# Server-only (Vercel serverless functions under api/) -- do NOT prefix with
# VITE_, that would expose them to the client bundle.
# Bug bin admin viewer (api/bug-reports.ts + src/pages/BugBin.tsx):
#   SUPABASE_SERVICE_ROLE_KEY -- from the bline Supabase project's
#     Project Settings > API > service_role key. Bypasses RLS to read
#     bug_reports (the anon key intentionally has no SELECT policy there).
#   ADMIN_SECRET -- any long random string you choose. Required as the
#     `x-admin-key` header value to read /api/bug-reports (bline has no
#     login system, so this is the only gate on the bin).
SUPABASE_SERVICE_ROLE_KEY=<bline service role key>
ADMIN_SECRET=<pick a long random string>

# Apple Maps Look Around (src/components/AppleLookAround.tsx). This is a public
# client token by design, but it MUST be domain-restricted in Apple Developer to
# bline-web.vercel.app (and any approved preview domain). Create it as a MapKit
# JS token under Certificates, Identifiers & Profiles > Services > Maps.
VITE_APPLE_MAPKIT_TOKEN=<domain-restricted Apple MapKit JS token>
